<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PS6 Concept UI - Exact Recreation</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Inter:wght@300;400;500;600;700&display=swap');

        :root {
            --ps-blue: #0070cc;
            --ps-gold: #c5a059;
            --ps-gold-light: #e8c77b;
            --bg-color: #000000;
            --text-color: #ffffff;
            --text-muted: rgba(255, 255, 255, 0.7);
            --glass-bg: rgba(20, 20, 25, 0.6);
            --glass-border: rgba(255, 255, 255, 0.1);
            --overlay-gradient: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.6) 40%, var(--bg-color) 100%);
            --modal-bg: rgba(15, 15, 15, 0.95);
            --card-shadow: rgba(0,0,0,0.5);
            --user-bg: #f0f4f8;
        }

        body.theme-light {
            --bg-color: #f8fafc;
            --text-color: #0f172a;
            --text-muted: rgba(15, 23, 42, 0.7);
            --glass-bg: rgba(255, 255, 255, 0.8);
            --glass-border: rgba(0, 0, 0, 0.1);
            --overlay-gradient: linear-gradient(to bottom, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.8) 40%, var(--bg-color) 100%);
            --modal-bg: rgba(255, 255, 255, 0.95);
            --card-shadow: rgba(0,0,0,0.1);
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background: var(--bg-color);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
            user-select: none;
            transition: background-color 0.5s ease, color 0.5s ease;
        }

        #app-container {
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        #dynamic-bg {
            position: absolute;
            inset: -5%;
            width: 110%;
            height: 110%;
            background-size: cover;
            background-position: center 20%;
            z-index: 0;
            transition: background-image 0.6s ease-in-out;
        }

        .bg-overlay {
            position: absolute;
            inset: 0;
            background: var(--overlay-gradient);
            z-index: 1;
            transition: background 0.5s ease;
        }

        #ui-layer {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            height: 100%;
            width: 100%;
        }

        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            box-shadow: 0 10px 30px var(--card-shadow);
        }

        .header-line { position: relative; }
        .header-line::after {
            content: ''; position: absolute; bottom: -8px; left: 0; width: 100%; height: 2px;
            background: var(--ps-blue); box-shadow: 0 0 10px var(--ps-blue);
        }

        .tab-active {
            border: 1px solid var(--ps-blue); border-radius: 999px; padding: 4px 20px;
            box-shadow: 0 0 15px rgba(0, 112, 204, 0.4) inset;
        }

        /* Shelf & Cards */
        #shelf-container { flex: 1; display: flex; align-items: flex-end; padding-bottom: 8vh; padding-left: 6vw; overflow: visible; }
        #shelf { display: flex; gap: 1.5vw; align-items: flex-end; transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1); }
        
        .card {
            width: clamp(100px, 10vw, 160px); height: clamp(140px, 14vw, 224px);
            border-radius: 16px; cursor: pointer; position: relative; flex-shrink: 0;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            -webkit-box-reflect: below 2px linear-gradient(transparent 60%, rgba(0,0,0,0.3));
        }

        .card:not(.active) { opacity: 0.7; transform: scale(0.95); }
        .card.active {
            width: clamp(140px, 14vw, 220px); height: clamp(200px, 20vw, 320px);
            transform: translateY(-20px); border: 2px solid var(--ps-blue);
            box-shadow: 0 0 25px rgba(0, 112, 204, 0.6); opacity: 1; z-index: 20;
        }

        .card-inner-ui {
            position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; align-items: center;
            padding: 20px 10px; background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%);
            border-radius: 14px; opacity: 0; transition: opacity 0.3s;
        }

        .card-bg-img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; position: absolute; inset: 0; z-index: -1; }
        .card.active .card-inner-ui { opacity: 1; }

        /* Views */
        .view-section {
            display: none; height: 100%; width: 100%; position: absolute; inset: 0; z-index: 15;
            background: var(--bg-color); padding: 100px 6vw 40px; animation: fadeIn 0.3s;
        }
        .view-section.active { display: block; }
        .hide-scroll::-webkit-scrollbar { display: none; }

        .gold-curve { position: absolute; z-index: 0; }
        .curve-tl { top: 0; left: 0; width: 40vw; max-width: 400px; }
        .curve-br { bottom: 0; right: 0; width: 40vw; max-width: 400px; transform: rotate(180deg); }

        .user-card {
            background: white; border-radius: 16px; width: 180px; height: 260px;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05); transition: all 0.3s; cursor: pointer;
            position: relative;
            -webkit-box-reflect: below 5px linear-gradient(transparent 50%, rgba(255,255,255,0.4));
        }
        .user-card:hover { transform: translateY(-10px); box-shadow: 0 15px 30px rgba(0,0,0,0.1); }
        .user-card.selected {
            background: linear-gradient(135deg, var(--ps-gold-light), var(--ps-gold));
            color: white; transform: translateY(-15px) scale(1.05); box-shadow: 0 20px 40px rgba(197, 160, 89, 0.4);
        }

        /* Animations */
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes slideDown { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        @keyframes pulseGlow { 0% { box-shadow: 0 0 0 0 rgba(197,160,89,0.7); } 70% { box-shadow: 0 0 0 15px rgba(197,160,89,0); } 100% { box-shadow: 0 0 0 0 rgba(197,160,89,0); } }

    </style>
</head>
<body class="theme-dark">

    <script>
        let psDrone, psBlip, psConfirm, psStartup;
        let audioInitialized = false;

        async function initAudio() {
            if (audioInitialized) return;
            await Tone.start();
            
            psDrone = new Tone.Oscillator({ frequency: 55, type: "sine", volume: -25 }).toDestination();
            
            psBlip = new Tone.Synth({
                oscillator: { type: "triangle" },
                envelope: { attack: 0.01, decay: 0.1, sustain: 0, release: 0.1 }
            }).toDestination();
            psBlip.volume.value = -15;

            psConfirm = new Tone.MembraneSynth({
                pitchDecay: 0.05, octaves: 4, oscillator: { type: "sine" },
                envelope: { attack: 0.01, decay: 0.4, sustain: 0.01, release: 1.4 }
            }).toDestination();
            psConfirm.volume.value = -10;

            psStartup = new Tone.FMSynth({
                harmonicity: 3, modulationIndex: 10, detachment: 0,
                oscillator: { type: "sine" }, envelope: { attack: 0.1, decay: 0.2, sustain: 1, release: 2 },
                modulation: { type: "square" }, modulationEnvelope: { attack: 0.01, decay: 0.5, sustain: 0.2, release: 0.1 }
            }).toDestination();
            psStartup.volume.value = -15;

            audioInitialized = true;
        }

        function playHover() { if(audioInitialized) psBlip.triggerAttackRelease("C5", "32n"); }
        function playConfirm() { if(audioInitialized) psConfirm.triggerAttackRelease("E2", "8n"); }
        function playBoot() { if(audioInitialized) psStartup.triggerAttackRelease("G2", "2n"); }
    </script>

