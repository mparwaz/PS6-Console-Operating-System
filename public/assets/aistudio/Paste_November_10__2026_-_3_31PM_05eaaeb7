                    <button class="text-left w-full px-4 py-3 rounded-lg glass-panel font-bold transition flex items-center gap-3"><i class="fas fa-paint-brush w-5 text-center"></i> Theme & Display</button>
                    <button class="text-left w-full px-4 py-3 rounded-lg hover:bg-[var(--glass-border)] opacity-70 hover:opacity-100 font-bold transition flex items-center gap-3" onclick="playHover()"><i class="fas fa-network-wired w-5 text-center"></i> Network</button>
                    <button class="text-left w-full px-4 py-3 rounded-lg hover:bg-[var(--glass-border)] opacity-70 hover:opacity-100 font-bold transition flex items-center gap-3" onclick="playHover()"><i class="fas fa-hdd w-5 text-center"></i> Storage</button>
                </div>

                <div class="w-2/3 pl-2 pt-16 flex flex-col gap-4">
                    <div class="glass-panel flex flex-col p-6 gap-4">
                        <div class="flex justify-between items-center pb-4 border-b border-[var(--glass-border)]">
                            <div>
                                <h3 class="font-bold text-lg">System Theme</h3>
                                <p class="text-xs text-[var(--text-muted)]">Switch between Light and Dark mode.</p>
                            </div>
                            <!-- Theme Toggle Switch -->
                            <div class="w-14 h-7 bg-gray-600 rounded-full relative cursor-pointer transition-colors duration-300" id="theme-toggle-bg" onclick="toggleTheme()">
                                <div class="w-5 h-5 bg-white rounded-full absolute left-1 top-1 transition-transform duration-300" id="theme-toggle-dot"></div>
                            </div>
                        </div>
                        <div class="flex justify-between items-center py-2 cursor-pointer hover:bg-[var(--glass-border)] rounded px-2 -mx-2 transition" onclick="playConfirm()">
                            <span class="font-semibold">Display Resolution</span>
                            <span class="text-[var(--text-muted)] text-sm">Automatic (8K) <i class="fas fa-chevron-right ml-2"></i></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="universal-modal" class="fixed inset-0 z-[9999] bg-black/60 backdrop-blur-md hidden flex items-center justify-center opacity-0 transition-opacity duration-300">
        <div class="glass-panel p-8 rounded-2xl w-full max-w-md shadow-2xl relative transform scale-95 transition-transform duration-300" id="modal-box">
            <button onclick="closeModal()" class="absolute top-4 right-4 text-[var(--text-muted)] hover:text-[var(--text-color)] transition text-xl">
                <i class="fas fa-times"></i>
            </button>
            <h3 class="text-2xl font-bold mb-4 flex items-center gap-3 text-[var(--ps-blue)]" id="modal-title">Title</h3>
            <div class="text-[var(--text-color)] text-sm leading-relaxed" id="modal-content">Content</div>
            <button onclick="closeModal()" class="mt-8 w-full bg-[var(--ps-blue)] hover:bg-blue-600 text-white py-2 rounded-full font-bold transition">Close</button>
        </div>
    </div>

    <script>
        // App Data matching images
        const appsData = [
            { id: 'store', type: 'system', title: 'PlayStation Store', bg: 'https://images.unsplash.com/photo-1606144042614-b2417e99c4e3?q=80&w=1920', cardStyle: 'bg-white text-black', innerHTML: `<div class="w-full h-full flex items-center justify-center"><i class="fas fa-shopping-bag text-5xl text-[var(--ps-blue)]"></i></div>`, pub: 'SONY' },
            { id: 'explore', type: 'explore', title: 'Explore', bg: 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1920', cardStyle: 'bg-black text-[var(--ps-gold)]', innerHTML: `<div class="w-full h-full flex flex-col items-center justify-center gap-2"><div class="grid grid-cols-2 gap-2 text-3xl"><i class="fas fa-times"></i><i class="far fa-circle"></i><i class="far fa-square"></i><i class="fas fa-caret-up"></i></div></div>`, pub: 'DISCOVER' },
            { id: 'tlou3', type: 'game', title: 'THE LAST OF US<br>PART III', bg: 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1920', cardImg: 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=400', pub: 'SONY' },
            { id: 'spidey3', type: 'game', title: 'SPIDER-MAN 3<br>THE FINAL CHAPTER', bg: 'https://images.unsplash.com/photo-1635805737707-575885ab0820?q=80&w=1920', cardImg: 'https://images.unsplash.com/photo-1635805737707-575885ab0820?q=80&w=400', pub: 'MARVEL' },
            { id: 'tlou1', type: 'game', title: 'THE LAST OF US', bg: 'https://images.unsplash.com/photo-1552820728-8b83bb6b773f?q=80&w=1920', cardImg: 'https://images.unsplash.com/photo-1552820728-8b83bb6b773f?q=80&w=400', pub: 'SONY' },
            { id: 'gta6', type: 'game', title: 'GRAND THEFT AUTO VI', bg: 'https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=1920', cardImg: 'https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=400', pub: 'ROCKSTAR' },
            { id: 'fc26', type: 'game', title: 'EA FC 26', bg: 'https://images.unsplash.com/photo-1574629810360-7efbbe195018?q=80&w=1920', cardImg: 'https://images.unsplash.com/photo-1574629810360-7efbbe195018?q=80&w=400', pub: 'EA SPORTS' },
            { id: 'rdr3', type: 'game', title: 'RED DEAD REDEMPTION III', bg: 'https://images.unsplash.com/photo-1533928298208-27ff66555d8d?q=80&w=1920', cardImg: 'https://images.unsplash.com/photo-1533928298208-27ff66555d8d?q=80&w=400', pub: 'ROCKSTAR' }
        ];

        let state = { view: 'all', activeIdx: 2, isLightMode: false };

        // Navigation Flow
        async function advanceToUserSelect() {
            await initAudio();
            playBoot();
            const boot = document.getElementById('boot-screen');
            boot.style.opacity = '0';
            setTimeout(() => {
                boot.classList.add('hidden');
                const userSelect = document.getElementById('user-select-screen');
                userSelect.classList.remove('hidden');
                setTimeout(() => userSelect.style.opacity = '1', 50);
            }, 1000);
        }

        function loginToHome() {
            playConfirm();
            if(audioInitialized) {
                psDrone.start();
                psDrone.volume.rampTo(-20, 2);
            }
            
            const userSelect = document.getElementById('user-select-screen');
            userSelect.style.opacity = '0';
            userSelect.style.transform = 'scale(1.1)';
            
            setTimeout(() => {
                userSelect.classList.add('hidden');
                const app = document.getElementById('app-container');
                app.classList.remove('hidden');
                setTimeout(() => app.style.opacity = '1', 50);
                updateUI();
                populateLibrary();
            }, 700);
        }

        // Theming
        function toggleTheme() {
            playHover();
            state.isLightMode = !state.isLightMode;
            const body = document.body;
            const dot = document.getElementById('theme-toggle-dot');
            const bg = document.getElementById('theme-toggle-bg');
            
            if (state.isLightMode) {
                body.classList.remove('theme-dark');
                body.classList.add('theme-light');
                dot.style.transform = 'translateX(28px)';
                bg.classList.replace('bg-gray-600', 'bg-[var(--ps-blue)]');
                // Adjust vision pro logo visibility for light mode
                document.querySelector('#widget-vision img').style.filter = 'none';
            } else {
                body.classList.remove('theme-light');
                body.classList.add('theme-dark');
                dot.style.transform = 'translateX(0)';
                bg.classList.replace('bg-[var(--ps-blue)]', 'bg-gray-600');
                document.querySelector('#widget-vision img').style.filter = 'brightness(0) invert(1)';
            }
        }

        // UI Updates
        function renderShelf() {
            const shelf = document.getElementById('shelf');
            shelf.innerHTML = '';
            appsData.forEach((app, idx) => {
                const isAct = idx === state.activeIdx;
                const card = document.createElement('div');
                card.className = `card ${isAct ? 'active' : ''} ${app.cardStyle || ''}`;
                
                if (app.innerHTML) {
                    card.innerHTML = app.innerHTML;
                } else {
                    card.style.background = 'transparent';
                    card.innerHTML = `<img src="${app.cardImg}" class="card-bg-img" alt="${app.title.replace(/<[^>]*>?/gm, '')}">`;
                }

                const btnText = app.type === 'explore' ? 'Enter Game' : 'Play Game';
                card.innerHTML += `
                    <div class="card-inner-ui">
                        <div class="bg-white/20 backdrop-blur-md text-white text-[8px] font-bold px-3 py-1 rounded-full mb-3">PS6</div>
                        <button class="w-[80%] py-2 rounded-full border border-[var(--ps-blue)] bg-black/60 text-white text-[10px] font-bold hover:bg-[var(--ps-blue)] transition" onclick="playConfirm(event)">${btnText}</button>
                    </div>
                `;

                card.onmouseenter = () => { if(state.activeIdx !== idx) selectApp(idx); };
                card.onclick = (e) => { if(isAct) playConfirm(e); };
                shelf.appendChild(card);
            });

            const cardWidth = window.innerWidth * 0.1;
            const offset = state.activeIdx * (cardWidth + (window.innerWidth*0.015));
            shelf.style.transform = `translateX(-${offset > window.innerWidth/3 ? offset - window.innerWidth/3 : 0}px)`;
        }

        function selectApp(idx) {
            state.activeIdx = idx;
            playHover();
            updateUI();
        }

        function updateUI() {
            const app = appsData[state.activeIdx];
            document.getElementById('dynamic-bg').style.backgroundImage = `url('${app.bg}')`;
            document.getElementById('game-title').innerHTML = app.title;
            document.getElementById('pub-name').innerHTML = app.pub;

            const wFriends = document.getElementById('widget-friends');
            const wVision = document.getElementById('widget-vision');
            const wStore = document.getElementById('widget-store');

            if (app.type === 'game') {
                wFriends.classList.remove('hidden'); setTimeout(() => wFriends.style.opacity = '1', 50);
                wVision.style.opacity = '0'; setTimeout(() => wVision.classList.add('hidden'), 300);
                wStore.style.opacity = '0'; setTimeout(() => wStore.classList.add('hidden'), 300);
            } else if (app.type === 'explore') {
                wFriends.style.opacity = '0'; setTimeout(() => wFriends.classList.add('hidden'), 300);
                wVision.classList.remove('hidden'); setTimeout(() => wVision.style.opacity = '1', 50);
                wStore.classList.remove('hidden'); setTimeout(() => wStore.style.opacity = '1', 50);
            } else {
                wFriends.style.opacity = '0'; wVision.style.opacity = '0'; wStore.style.opacity = '0';
            }
            renderShelf();
        }

        function switchTab(viewName) {
            playConfirm();
            document.querySelectorAll('.view-section').forEach(el => el.classList.remove('active'));
            document.getElementById('ui-layer').classList.remove('hidden');
            if(viewName !== 'all') document.getElementById(`view-${viewName}`).classList.add('active');
        }

        // Modals
        function openModal(title, content) {
            playHover();
            const modal = document.getElementById('universal-modal');
            const box = document.getElementById('modal-box');
            document.getElementById('modal-title').innerHTML = `<i class="fas fa-info-circle"></i> ${title}`;
            document.getElementById('modal-content').innerHTML = content;
            
            modal.classList.remove('hidden');
            // Small delay for display block to apply before animating opacity
            setTimeout(() => {
                modal.style.opacity = '1';
                box.style.transform = 'scale(1)';
            }, 10);
        }

        function closeModal() {
            playHover();
            const modal = document.getElementById('universal-modal');
            const box = document.getElementById('modal-box');
            modal.style.opacity = '0';
            box.style.transform = 'scale(0.95)';
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        // Utilities
        function populateLibrary() {
            const grid = document.getElementById('library-grid');
            const libraryGames = appsData.filter(a => a.type === 'game');
            grid.innerHTML = '';
            [...libraryGames, ...libraryGames, ...libraryGames].slice(0, 18).forEach((app, i) => {
                grid.innerHTML += `
                <div class="group cursor-pointer relative" style="animation: fadeIn 0.5s ease-out ${(i*0.05).toFixed(2)}s both;" onclick="playConfirm()">
                    <div class="aspect-[3/4] rounded-xl bg-cover bg-center border-2 border-transparent group-hover:border-[var(--ps-blue)] transition-all duration-300 shadow-lg relative overflow-hidden" >
                        <img src="${app.cardImg}" class="w-full h-full object-cover absolute inset-0">
                        <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition flex items-center justify-center backdrop-blur-sm">
                            <i class="fas fa-play text-3xl text-white transform scale-50 group-hover:scale-100 transition"></i>
                        </div>
                    </div>
                    <p class="mt-2 text-xs font-semibold truncate opacity-80 group-hover:opacity-100 transition">${app.title.replace(/<br>/g, ' ')}</p>
                </div>`;
            });
        }

        setInterval(() => {
            const d = new Date();
            const timeStr = `${d.getHours().toString().padStart(2, '0')}:${d.getMinutes().toString().padStart(2, '0')}`;
            document.querySelectorAll('.clock-display').forEach(el => el.innerText = timeStr);
        }, 1000);

        window.addEventListener('keydown', (e) => {
            if (document.getElementById('app-container').classList.contains('hidden')) return;
            if (e.key === 'ArrowRight') selectApp((state.activeIdx + 1) % appsData.length);
            if (e.key === 'ArrowLeft') selectApp((state.activeIdx - 1 + appsData.length) % appsData.length);
            if (e.key === 'Enter') playConfirm();
            if (e.key === 'Escape') closeModal();
        });

    </script>
</body>
</html>